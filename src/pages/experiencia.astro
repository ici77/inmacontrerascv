---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('experience', ({ data }) => data.status === 'published');
const development = entries.filter(({ data }) => data.experienceType === 'teaching-development');
const tutoring = entries.filter(({ data }) => data.experienceType === 'tutoring');
const administration = entries.filter(({ data }) => data.experienceType === 'teaching-administration');
const projects = await getCollection('projects', ({ data }) => data.status === 'published');
const perrolia = projects.find(({ id }) => id === 'perrolia');
const devcampus = projects.find(({ id }) => id === 'devcampus');
const avanteTutor = tutoring.find(({ data }) => data.organisation === 'Avante Formación, S.L.L.');
const coreTutor = tutoring.find(({ data }) => data.organisation === 'Core Networks, S.L.');
const chamberTutor = tutoring.find(({ data }) => data.organisation === 'Cámara Oficial de Comercio');
const date = new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
const dates = (start?: string, end?: string) => start && end ? `${date.format(new Date(`${start}T00:00:00`))}–${date.format(new Date(`${end}T00:00:00`))}` : 'Fecha pendiente';
const title = (entry: typeof development[number]) => entry.data.moduleCode ? `${entry.data.moduleCode} — ${entry.data.specialty}` : entry.data.specialty;
---
<BaseLayout title="Experiencia docente en Desarrollo Web y FPE | Inma Contreras" description="Experiencia docente en programación, desarrollo web, certificados profesionales IFCD0210, teleformación y tutorización para Formación Profesional para el Empleo.">
  <section class="container py-16 lg:py-20"><p class="eyebrow">Perfil profesional</p><h1 class="display mt-3 text-5xl text-earth sm:text-6xl">Experiencia docente y profesional</h1><p class="mt-4 text-xl font-medium text-clay">Programación, desarrollo web, teleformación y formación para el empleo.</p><p class="mt-5 max-w-4xl text-lg text-[#66412d]">Colaboro con centros de formación y entidades educativas impartiendo acciones formativas en el ámbito tecnológico y empresarial. Combino experiencia docente, conocimientos técnicos y una trayectoria profesional de más de veinte años en el sector bancario.</p></section>

  <nav aria-label="Áreas de experiencia" class="sticky top-0 z-10 border-b border-sand bg-cream/95 py-3 backdrop-blur"><div class="container flex flex-wrap gap-2"><a href="#desarrollo-web" class="rounded-full border border-sand px-4 py-2 text-sm font-semibold text-earth no-underline hover:bg-beige">Programación y desarrollo web</a><a href="#teleformacion" class="rounded-full border border-sand px-4 py-2 text-sm font-semibold text-earth no-underline hover:bg-beige">Teleformación y tutorización</a><a href="#administracion" class="rounded-full border border-sand px-4 py-2 text-sm font-semibold text-earth no-underline hover:bg-beige">Administración y empresa</a><a href="#proyectos-tecnologicos" class="rounded-full border border-sand px-4 py-2 text-sm font-semibold text-earth no-underline hover:bg-beige">Proyectos tecnológicos</a><a href="#banca" class="rounded-full border border-sand px-4 py-2 text-sm font-semibold text-earth no-underline hover:bg-beige">Trayectoria bancaria</a></div></nav>

  <section id="desarrollo-web" class="container scroll-mt-24 py-16"><p class="eyebrow">Especialidad docente</p><h2 class="display mt-3 text-4xl text-earth">Programación y desarrollo web</h2><p class="mt-4 max-w-3xl text-[#66412d]">Experiencia en la impartición de certificados profesionales y módulos formativos relacionados con el desarrollo de aplicaciones web, la programación y la implantación de proyectos digitales.</p><div class="mt-8 grid gap-5 lg:grid-cols-2">{development.map((entry) => <article class="rounded-2xl border border-sand bg-cream p-6"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">{entry.data.organisation}</p><h3 class="font-display mt-2 text-2xl text-earth">{title(entry)}</h3><p class="mt-3 text-sm font-semibold text-[#66412d]">{dates(entry.data.startDate, entry.data.endDate)}</p><p class="mt-4 text-2xl font-bold text-terracotta">{entry.data.teachingHours} h <span class="text-sm font-semibold text-earth">de impartición</span></p>{entry.data.organisation === 'Core Networks, S.L.' && <p class="mt-4 text-sm text-earth">Impartición completa del módulo de Implantación de aplicaciones web, con especial atención a WordPress, GitHub y la gestión de proyectos web.</p>}{entry.data.modules.length > 0 && <details class="mt-5 border-t border-sand pt-4"><summary class="cursor-pointer font-bold text-clay">Ver contenidos</summary><div class="mt-4 space-y-4">{entry.data.modules.map((module) => <section><h4 class="font-semibold text-earth">{module.code && `${module.code} — `}{module.title} <span class="text-clay">({module.hours} h)</span></h4>{module.contents.length > 0 && <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[#66412d]">{module.contents.map((content) => <li>{content}</li>)}</ul>}</section>)}</div></details>}</article>)}</div></section>

  <section id="teleformacion" class="scroll-mt-24 border-y border-sand/70 bg-beige/50 py-16"><div class="container"><p class="eyebrow">Acompañamiento</p><h2 class="display mt-3 text-4xl text-earth">Teleformación y tutorización</h2><p class="mt-4 max-w-3xl text-[#66412d]">Experiencia en el acompañamiento y seguimiento del alumnado, tanto en acciones de teleformación como durante las prácticas profesionales en empresas.</p><div class="mt-8 grid gap-5 lg:grid-cols-3">{chamberTutor && <article class="rounded-2xl bg-cream p-6"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">Cámara de Comercio</p><h3 class="font-display mt-2 text-2xl text-earth">Sistemas de Información Geográfica con gvSIG</h3><p class="mt-3 text-sm font-semibold text-[#66412d]">{dates(chamberTutor.data.startDate, chamberTutor.data.endDate)} · Teleformación</p><p class="mt-4 text-2xl font-bold text-terracotta">{chamberTutor.data.tutoringHours} h <span class="text-sm font-semibold text-earth">de tutorización</span></p><details class="mt-5 border-t border-sand pt-4"><summary class="cursor-pointer font-bold text-clay">Ver ámbito tecnológico</summary><ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[#66412d]"><li>Sistemas de Información Geográfica y gvSIG.</li><li>Información territorial y cartografía digital.</li><li>Seguimiento del alumnado en modalidad online.</li></ul></details></article>}{avanteTutor && <article class="rounded-2xl bg-cream p-6"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">Avante Formación</p><h3 class="font-display mt-2 text-2xl text-earth">Tutorización de prácticas profesionales del IFCD0210</h3><p class="mt-3 text-sm font-semibold text-[#66412d]">{dates(avanteTutor.data.startDate, avanteTutor.data.endDate)} · Jornada contractual del 12,5 %</p><p class="mt-4 text-sm font-semibold text-clay">Seguimiento de prácticas profesionales · Estimación aproximada de {avanteTutor.data.tutoringHours?.toLocaleString('es-ES')} h.</p><details class="mt-5 border-t border-sand pt-4"><summary class="cursor-pointer font-bold text-clay">Ver aclaración</summary><p class="mt-3 text-sm text-[#66412d]">Esta estimación no equivale a horas de clase impartidas y no se suma a los indicadores declarados.</p></details></article>}{coreTutor && <article class="rounded-2xl bg-cream p-6"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">Core Networks</p><h3 class="font-display mt-2 text-2xl text-earth">Tutorización y seguimiento de prácticas profesionales</h3><p class="mt-3 text-sm font-semibold text-[#66412d]">{dates(coreTutor.data.startDate, coreTutor.data.endDate)}</p><p class="mt-4 text-sm text-earth">Realizada dentro del mismo contrato en el que se impartió MF0493_3.</p><details class="mt-5 border-t border-sand pt-4"><summary class="cursor-pointer font-bold text-clay">Ver aclaración</summary><p class="mt-3 text-sm text-[#66412d]">Las horas de tutorización no cuentan con desglose y permanecen fuera de los totales globales.</p></details></article>}</div></div></section>

  <section id="administracion" class="container scroll-mt-24 py-16"><p class="eyebrow">Proyectos Integrales</p><h2 class="display mt-3 text-4xl text-earth">Administración, gestión empresarial y atención al cliente</h2><p class="mt-4 max-w-3xl text-[#66412d]">He impartido distintas acciones formativas en el marco de Proyectos Integrales, relacionadas con seguros, atención al cliente, reclamaciones y organización de eventos.</p><p class="mt-4 font-semibold text-clay">{administration.reduce((total, entry) => total + (entry.data.teachingHours ?? 0), 0)} horas de impartición</p><div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">{administration.map((entry) => <article class="rounded-xl border border-sand bg-cream p-5"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">{entry.data.organisation.includes('Dabo') ? 'Grupo Dabo' : 'Direccionate'}</p><h3 class="font-display mt-2 text-xl text-earth">{entry.data.specialty}</h3><p class="mt-3 text-sm text-[#66412d]">{dates(entry.data.startDate, entry.data.endDate)}</p><p class="mt-4 font-bold text-terracotta">{entry.data.teachingHours} h</p></article>)}</div></section>

  <section id="proyectos-tecnologicos" class="scroll-mt-24 border-y border-sand/70 bg-beige/50 py-16"><div class="container"><p class="eyebrow">Desarrollo web · proyectos propios</p><h2 class="display mt-3 text-4xl text-earth">También desarrollo los proyectos sobre los que enseño</h2><div class="mt-4 max-w-4xl space-y-4 text-[#66412d]"><p>Mi experiencia tecnológica va más allá de la impartición de formación. Como desarrolladora web, trabajo en proyectos digitales propios que me permiten aplicar mis conocimientos de programación, diseño y desarrollo de aplicaciones a necesidades reales.</p><p>Esta actividad complementa mi labor docente: mantenerme vinculada al desarrollo de proyectos me ayuda a trasladar al aula una perspectiva práctica y actualizada de las tecnologías que enseño.</p></div><div class="mt-8 grid gap-5 lg:grid-cols-2">{perrolia && <article class="rounded-2xl border border-terracotta/40 bg-cream p-6 shadow-sm"><div class="flex min-h-16 items-center"><img src={perrolia.data.image} alt={perrolia.data.imageAlt} width="180" height="90" loading="lazy" class="h-14 w-auto object-contain" /></div><p class="mt-5 text-xs font-bold tracking-[.12em] text-clay uppercase">{perrolia.data.role}</p><h3 class="font-display mt-2 text-2xl text-earth">{perrolia.data.title}</h3><p class="mt-4 text-[#66412d]">{perrolia.data.description ?? perrolia.data.summary}</p><a href={perrolia.data.externalUrl} class="mt-6 inline-flex min-h-11 items-center rounded-full bg-terracotta px-5 py-3 font-semibold text-white no-underline transition-colors hover:bg-clay" target="_blank" rel="noopener noreferrer">Conocer Perrolia <span class="ml-2" aria-hidden="true">↗</span></a></article>}{devcampus && <article class="rounded-2xl border border-sand bg-cream p-6"><div class="flex min-h-16 items-center"><img src={devcampus.data.image} alt={devcampus.data.imageAlt} width="180" height="90" loading="lazy" class="h-14 w-auto object-contain" /></div><p class="mt-5 text-xs font-bold tracking-[.12em] text-clay uppercase">{devcampus.data.role}</p><h3 class="font-display mt-2 text-2xl text-earth">{devcampus.data.title}</h3><p class="mt-4 text-[#66412d]">{devcampus.data.description ?? devcampus.data.summary}</p><a href={devcampus.data.externalUrl} class="mt-6 inline-flex min-h-11 items-center rounded-full border border-earth px-5 py-3 font-semibold text-earth no-underline transition-colors hover:bg-beige">Descubrir DevCampus <span class="ml-2" aria-hidden="true">→</span></a></article>}</div></div></section>

  <section id="banca" class="scroll-mt-24 border-y border-sand/70 bg-earth py-16 text-cream"><div class="container max-w-4xl"><p class="eyebrow text-sand">Trayectoria profesional</p><h2 class="display mt-3 text-4xl">Experiencia profesional en el sector bancario</h2><p class="mt-5 text-beige">Más de veinte años de trayectoria en banca aportan una visión práctica de la gestión de clientes, los procesos administrativos y empresariales, la comunicación profesional, la resolución de incidencias y el uso de herramientas digitales en entornos organizativos.</p></div></section>
</BaseLayout>
