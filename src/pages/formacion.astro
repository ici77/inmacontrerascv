---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const formations = (await getCollection('formation', ({ data }) => data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
const categories = [
  'Titulaciones oficiales y formación superior',
  'Programación, desarrollo web, datos e inteligencia artificial',
  'Docencia, teleformación y educación',
  'Administración, recursos humanos, contabilidad y finanzas',
  'Igualdad de género, empresa y empleo',
  'Unidades de competencia profesional acreditadas',
];
const byCategory = (category: string) => formations.filter(({ data }) => data.category === category);
const details = (entry: typeof formations[number]) => [entry.data.dateLabel ?? [entry.data.startDate, entry.data.endDate].filter(Boolean).join(' – '), entry.data.hours ? `${entry.data.hours} horas` : undefined, entry.data.ects ? `${entry.data.ects} ECTS` : undefined].filter(Boolean).join(' · ');
const dam = formations.find(({ data }) => data.title === 'Técnico Superior en Desarrollo de Aplicaciones Multiplataforma (DAM)');
const teachingMaster = formations.find(({ data }) => data.title.startsWith('Máster Universitario en Formación del Profesorado'));
const onlineTeacher = formations.find(({ data }) => data.title.startsWith('SSCE002PO Acreditación Docente para Teleformación'));
const iamFormations = formations.filter(({ data }) => data.entity === 'Instituto Andaluz de la Mujer, Junta de Andalucía');
const iamHours = iamFormations.reduce((total, { data }) => total + (data.hours ?? 0), 0);
---
<BaseLayout title="Formación y acreditaciones docentes | Inma Contreras" description="Formación y acreditaciones de Inma Contreras en desarrollo web, programación, inteligencia artificial, docencia, teleformación y diseño didáctico.">
  <section class="container py-16 lg:py-20"><p class="eyebrow">Perfil docente</p><h1 class="display mt-3 max-w-4xl text-5xl text-earth sm:text-6xl">Formación para enseñar tecnología con criterio y cercanía.</h1><p class="mt-5 max-w-3xl text-lg text-[#66412d]">Una base que reúne desarrollo de aplicaciones, formación pedagógica y experiencia profesional, reforzada por actualización continua en programación, inteligencia artificial, teleformación y competencias digitales.</p></section>

  <section class="border-y border-sand/70 bg-beige/50 py-8"><div class="container grid gap-4 md:grid-cols-3"><article class="flex min-h-32 flex-col rounded-xl bg-cream p-5"><p class="eyebrow">Base técnica</p><p class="font-display mt-2 text-2xl text-earth">Desarrollo web, programación e IA</p></article><article class="flex min-h-32 flex-col rounded-xl bg-cream p-5"><p class="eyebrow">Enseñanza</p><p class="font-display mt-2 text-2xl text-earth">Docencia, teleformación y diseño didáctico</p></article><article class="flex min-h-32 flex-col rounded-xl bg-cream p-5"><p class="eyebrow">Desarrollo de proyectos</p><p class="font-display mt-2 text-2xl text-earth">Aplicaciones web y soluciones digitales propias</p></article></div></section>

  <section class="container py-16"><p class="eyebrow">Formación destacada</p><h2 class="display mt-3 text-4xl text-earth">Preparación para la docencia en programación y desarrollo web</h2><div class="mt-8 grid gap-5 md:grid-cols-2">{dam && <article class="rounded-2xl border border-sand bg-cream p-6"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">{dam.data.entity}</p><h3 class="font-display mt-3 text-2xl text-earth">{dam.data.title}</h3><p class="mt-3 text-sm font-semibold text-[#66412d]">{details(dam)}</p><p class="mt-4 text-sm text-earth">{dam.data.description}</p></article>}{teachingMaster && <article class="rounded-2xl border border-sand bg-cream p-6"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">{teachingMaster.data.entity}</p><h3 class="font-display mt-3 text-2xl text-earth">Máster Universitario en Formación del Profesorado</h3><p class="mt-3 text-sm font-semibold text-[#66412d]">{details(teachingMaster)}</p><p class="mt-4 text-sm text-earth">{teachingMaster.data.description}</p></article>}{onlineTeacher && <article class="rounded-2xl border border-sand bg-cream p-6"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">{onlineTeacher.data.entity}</p><h3 class="font-display mt-3 text-2xl text-earth">SSCE002PO Acreditación Docente para Teleformación: Formador/a Online</h3><p class="mt-3 text-sm font-semibold text-[#66412d]">{details(onlineTeacher)}</p><p class="mt-4 text-sm text-earth">{onlineTeacher.data.description}</p></article>}<article class="rounded-2xl border border-sand bg-cream p-6"><p class="text-xs font-bold tracking-[.12em] text-clay uppercase">Instituto Andaluz de la Mujer, Junta de Andalucía</p><h3 class="font-display mt-3 text-2xl text-earth">Más de 100 horas de formación especializada en igualdad</h3><p class="mt-3 text-sm font-semibold text-[#66412d]">{iamHours} horas en formación para planes de igualdad, seguimiento, prevención del acoso y corresponsabilidad.</p><p class="mt-4 text-sm text-earth">Especialización complementaria para incorporar la igualdad efectiva a la formación y a los entornos profesionales.</p></article></div></section>

  <nav aria-label="Áreas de formación" class="sticky top-0 z-10 border-y border-sand bg-cream/95 py-3 backdrop-blur"><div class="container flex flex-wrap gap-2">{categories.map((category, index) => <a href={`#formacion-${index + 1}`} class="rounded-full border border-sand px-4 py-2 text-sm font-semibold text-earth no-underline hover:bg-beige">{category.replace('Titulaciones oficiales y formación superior', 'Titulaciones').replace('Programación, desarrollo web, datos e inteligencia artificial', 'Tecnología').replace('Docencia, teleformación y educación', 'Docencia').replace('Administración, recursos humanos, contabilidad y finanzas', 'Administración').replace('Igualdad de género, empresa y empleo', 'Igualdad').replace('Unidades de competencia profesional acreditadas', 'Competencias')}</a>)}</div></nav>

  <div class="container space-y-5 py-16">{categories.map((category, index) => { const entries = byCategory(category); return <section id={`formacion-${index + 1}`} class="scroll-mt-24 rounded-2xl border border-sand bg-cream"><details open={index < 3} class="group"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 [&::-webkit-details-marker]:hidden"><span><span class="eyebrow">{entries.length} acreditaciones</span><span class="display mt-2 block text-3xl text-earth">{category}</span></span><span aria-hidden="true" class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-sand text-clay group-open:rotate-45">+</span></summary><div class="border-t border-sand px-6 pb-6 pt-5"><div class="grid gap-4 lg:grid-cols-2">{entries.map((entry) => <article class="rounded-xl bg-beige/40 p-5"><h3 class="font-display text-xl text-earth">{entry.data.title}</h3><p class="mt-2 text-sm font-semibold text-clay">{entry.data.entity}</p>{details(entry) && <p class="mt-3 text-sm text-[#66412d]">{details(entry)}</p>}<details class="mt-4"><summary class="cursor-pointer text-sm font-bold text-clay">Ver competencias acreditadas</summary><p class="mt-2 text-sm leading-relaxed text-earth">{entry.data.description}</p>{entry.data.skills.length > 0 && <ul class="mt-3 flex flex-wrap gap-2">{entry.data.skills.map((skill) => <li class="rounded-full border border-sand px-2 py-1 text-xs text-earth">{skill}</li>)}</ul>}</details></article>)}</div></div></details></section>})}</div>
</BaseLayout>
