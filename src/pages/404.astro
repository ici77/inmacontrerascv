---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada | Inma Contreras" description="La página solicitada no está disponible." noindex>
  <section class="container max-w-3xl py-24 sm:py-32">
    <p class="eyebrow">Error 404</p>
    <h1 class="display mt-4 text-5xl text-earth sm:text-6xl">Esta página no está disponible</h1>
    <p class="mt-6 text-lg text-[#66412d]">Es posible que la dirección haya cambiado o que el contenido ya no exista.</p>
    <a href="/" class="mt-8 inline-flex min-h-11 items-center rounded-full bg-terracotta px-6 py-3 font-semibold text-white no-underline transition-colors hover:bg-clay">Volver a la portada <span class="ml-2" aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
