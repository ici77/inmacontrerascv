---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/home/ContactForm.astro';
---
<BaseLayout title="Contactar con Inma Contreras | Docente FPE" description="Contacta con Inma Contreras para colaborar en proyectos de Formación Profesional para el Empleo, programación, desarrollo web, teleformación y diseño de contenidos educativos.">
  <section class="container py-16 sm:py-20 lg:py-24"><div class="max-w-3xl"><p class="eyebrow">Contacto · colaboraciones docentes</p><h1 class="display mt-4 text-5xl text-earth sm:text-6xl">Hablemos de tu próximo proyecto formativo</h1><p class="mt-6 text-lg text-[#66412d]">Si buscas una docente para impartir formación en programación, desarrollo web o competencias digitales, estaré encantada de conocer tu propuesta.</p><p class="mt-4 text-lg text-[#66412d]">También puedes contactar conmigo para colaborar en proyectos de teleformación, diseño de contenidos educativos o desarrollo de recursos didácticos.</p></div><figure class="mx-auto mt-8 hidden w-full max-w-xl overflow-hidden rounded-xl border border-sand bg-beige p-1 md:block"><img src="/inmacv.png" width="1024" height="1024" loading="eager" alt="Fotografía de Inma Contreras, docente y desarrolladora web" class="h-auto w-full rounded-lg object-contain" /></figure><div class="mt-12 grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-16"><div class="space-y-4 border-t border-sand pt-6"><div><p class="text-xs font-bold tracking-[.14em] text-clay uppercase">Correo electrónico</p><a href="mailto:hola@inmacontreras.com" class="mt-1 inline-block font-semibold text-earth no-underline hover:text-clay">hola@inmacontreras.com</a></div><div><p class="text-xs font-bold tracking-[.14em] text-clay uppercase">LinkedIn</p><a href="https://www.linkedin.com/in/ici77/" class="mt-1 inline-flex items-center gap-2 font-semibold text-earth no-underline hover:text-clay" target="_blank" rel="noopener noreferrer">LinkedIn — Inma Contreras <span aria-hidden="true">↗</span></a></div></div><div><div class="mb-6"><p class="eyebrow">Escríbeme</p><h2 class="font-display mt-3 text-3xl text-earth">Cuéntame en qué podemos colaborar</h2></div><ContactForm /></div></div></section>
</BaseLayout>
